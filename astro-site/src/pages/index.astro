---
import { siGithub } from "simple-icons";
import "../styles/editorial.css";

const files = import.meta.glob("../content/projects/*.md", { eager: true });

const projects = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, module]) => ({
    ...module.frontmatter,
    slug: path.split("/").pop().replace(".md", ""),
  }));
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Engineering projects by Joe Hanko, including Dirac Delta rocket avionics and the MACK-10 tensile tester."
    />
    <title>Joe Hanko — Engineering Projects</title>
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <a href="/" class="brand">Joe Hanko</a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href="/projects/">Projects</a>
          <a href="#about">About</a>
          <a href="https://github.com/joehanko" class="github-link">
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={siGithub.path}></path>
            </svg>
            GitHub
          </a>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="page-title">
          <p class="eyebrow hero-role">
            <span aria-hidden="true">✹</span> Mechanical engineering student
          </p>
          <h1 id="page-title">Engineering<br />projects</h1>
          <p class="intro">
            Projects in rocket avionics, ground software, and mechanical test
            equipment.
          </p>
          <div class="hero-actions">
            <a href="/projects/" class="action action-primary">View projects</a>
            <a href="#about" class="action">About me</a>
          </div>
        </section>

        {
          projects.length > 0 && (
            <section id="work" aria-labelledby="work-title" class="work">
              <div class="work-heading">
                <h2 id="work-title">Projects</h2>
                <a class="eyebrow all-projects" href="/projects/">
                  All projects <span aria-hidden="true">↗</span>
                </a>
              </div>
              <div class="project-grid">
                {projects.map((project) => (
                  <article class="project">
                    <a class="project-card" href={`/projects/${project.slug}/`}>
                      {project.cover && (
                        <div class="project-media">
                          <img
                            src={project.cover}
                            alt={project.coverAlt || project.title}
                            loading="lazy"
                          />
                        </div>
                      )}
                      <div class="project-copy">
                        <h3>
                          {project.title}
                          <span aria-hidden="true">↗</span>
                        </h3>
                        <p class="eyebrow project-meta">
                          {project.category} · {project.year}
                        </p>
                        <p class="project-summary">{project.summary}</p>
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            </section>
          )
        }

        <section id="about" class="about" aria-labelledby="about-title">
          <h2 id="about-title">About</h2>
          <p>
            My background is in technology and software, and I’m studying
            mechanical engineering. I’m interested in test equipment and
            instrumentation, especially the decisions that connect physical
            hardware to the data it produces.
          </p>
        </section>
      </main>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Joe Hanko</span>
        <a href="https://github.com/joehanko" class="github-link">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d={siGithub.path}></path>
          </svg>
          GitHub
        </a>
      </footer>
    </div>
  </body>
</html>

<style>
  h1,
  h2,
  h3 {
    margin: 0;
    font-family: var(--display);
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: clamp(76px, 10vw, 136px) clamp(85px, 12vw, 156px);
    text-align: center;
  }

  .hero-role {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #2e2e2e;
    font-size: 13px;
    font-weight: 600;
  }

  .hero-role span {
    color: var(--accent-strong);
    font-size: 16px;
    line-height: 1;
  }

  h1 {
    margin-block: 24px 32px;
    font-size: clamp(34px, 4.3vw, 58px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.028em;
    text-transform: uppercase;
  }

  .intro,
  .about p {
    max-width: 410px;
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding-inline: 20px;
    border: 1px solid var(--ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .action-primary {
    color: var(--paper);
    background: var(--ink);
  }
  .action:hover {
    color: var(--ink);
    background: var(--accent);
  }

  .work-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }
  .all-projects:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .work {
    border-top: 1px solid var(--rule);
    padding-top: clamp(34px, 5vw, 70px);
  }
  h2 {
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.022em;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    column-gap: var(--grid-gap);
    row-gap: 44px;
    margin-top: 32px;
  }

  .project {
    min-width: 0;
  }
  .project-card {
    display: block;
  }
  .project-media {
    background: var(--panel);
  }
  .project-media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .project-copy {
    padding-top: 15px;
  }
  .project-card:not(:has(.project-media)) {
    border-top: 1px solid var(--rule);
  }
  .project h3 {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 6px;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .project h3 span {
    color: var(--muted);
  }
  .project-card:hover h3 {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }
  .project-meta {
    color: #626262;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .project-summary {
    max-width: 51ch;
    margin: 9px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--grid-gap);
    margin-block: var(--section-space);
    padding: clamp(25px, 5vw, 60px);
    background: var(--panel);
  }

  @media (max-width: 760px) {
    .project-grid,
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
