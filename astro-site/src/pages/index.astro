---
const files = import.meta.glob("../content/projects/*.md", { eager: true });

const projects = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, module]) => ({
    ...module.frontmatter,
    slug: path.split("/").pop().replace(".md", ""),
  }));

const featured = projects.find((project) => project.slug === "delta-l1");
const otherProjects = projects.filter((project) => project !== featured);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Engineering projects by Joe Hanko, including Dirac Delta rocket avionics and the MACK-10 tensile tester." />
    <title>Joe Hanko — Engineering Projects</title>
  </head>

  <body>
    <div class="container">
      <header class="site-header">
        <a href="/" class="brand">Joe Hanko<span>.</span></a>
        <nav aria-label="Main navigation">
          <a href="#work">Projects</a>
          <a href="#about">About</a>
          <a href="https://github.com/joehanko">GitHub ↗</a>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="page-title">
          <p class="eyebrow">Mechanical engineering · Project notes</p>
          <h1 id="page-title">Engineering projects</h1>
          <p class="intro">
            I’m Joe Hanko, a mechanical engineering student. This site documents
            my work on rocket avionics, ground software, and a desktop
            tensile tester.
          </p>
        </section>

        <section id="work" aria-label="Selected projects">
          {featured && (
            <article class:list={["featured", { "with-image": featured.cover }]}>
              <div class="feature-copy">
                <p class="eyebrow">Featured case study <span>{featured.year}</span></p>
                <h2>{featured.title}</h2>
                <p class="feature-summary">{featured.summary}</p>
                <a class="feature-link" href={`/projects/${featured.slug}/`}>Read the case study <span aria-hidden="true">↗</span></a>
              </div>
              {featured.cover && (
                <figure class="feature-figure">
                  <img src={featured.cover} alt={featured.coverAlt || featured.title} />
                  {featured.coverCaption && <figcaption>{featured.coverCaption}</figcaption>}
                </figure>
              )}
            </article>
          )}

          {otherProjects.length > 0 && (
            <section class="other-work" aria-labelledby="other-title">
              <p class="eyebrow">Project index</p>
              <h2 id="other-title">{featured ? "More projects" : "Selected projects"}</h2>
              {otherProjects.map((project) => (
                <article class="project-row">
                  {project.cover && (
                    <img src={project.cover} alt={project.coverAlt || project.title} loading="lazy" />
                  )}
                  <div>
                    <p class="eyebrow">{project.category} <span>{project.year}</span></p>
                    <h3><a href={`/projects/${project.slug}/`}>{project.title}</a></h3>
                    <p class="project-summary">{project.summary}</p>
                  </div>
                  <a class="project-link" href={`/projects/${project.slug}/`} aria-label={`Read about ${project.title}`}>↗</a>
                </article>
              ))}
            </section>
          )}
        </section>

        <section id="about" class="about" aria-labelledby="about-title">
          <p class="eyebrow">About</p>
          <h2 id="about-title">Joe Hanko</h2>
          <p>
            My background is in technology and software, and I’m studying
            mechanical engineering. I’m interested in test equipment and
            instrumentation, especially the decisions that connect physical
            hardware to the data it produces.
          </p>
        </section>
      </main>

      <footer>
        <span>© {new Date().getFullYear()} Joe Hanko</span>
        <a href="https://github.com/joehanko">GitHub ↗</a>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    background: #fafaf8;
    color: #222522;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible) { outline: 2px solid currentColor; outline-offset: 5px; }
  .container { width: min(100% - 3rem, 1160px); margin-inline: auto; }
  .site-header, footer {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 16px; padding: 25px 0; border-bottom: 1px solid #d8dcd5;
  }
  .brand { font-size: 18px; font-weight: 700; }
  .brand span { color: #456a59; }
  nav { display: flex; gap: clamp(15px, 3vw, 32px); font-size: 13px; color: #4b554e; }
  nav a:hover, footer a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .hero { padding: clamp(52px, 9vw, 110px) 0 clamp(46px, 7vw, 78px); }
  .eyebrow {
    margin: 0; font-size: 11px; line-height: 1.55; letter-spacing: .12em;
    text-transform: uppercase; font-weight: 700; color: #456354;
  }
  h1, h2, h3 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-weight: 400; }
  h1 { font-size: clamp(42px, 7vw, 88px); line-height: 1.04; letter-spacing: -.055em; margin: 14px 0 18px; }
  .intro { max-width: 55ch; margin: 0; font-size: clamp(17px, 2vw, 20px); line-height: 1.65; color: #505751; }
  .featured {
    display: grid; overflow: hidden; border: 1px solid #263a31; border-radius: 5px;
    color: #f8f8f1; background: #20332a;
  }
  .featured.with-image { grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr); }
  .feature-copy { padding: clamp(24px, 5vw, 56px); align-self: center; }
  .feature-copy .eyebrow { color: #c5d7c8; }
  .eyebrow span { margin-inline-start: .65em; }
  .feature-copy h2 { margin-top: 15px; font-size: clamp(34px, 5vw, 58px); line-height: 1.07; letter-spacing: -.035em; }
  .feature-summary { max-width: 44ch; color: #e0e8df; line-height: 1.65; margin: 17px 0 25px; }
  .feature-link {
    display: inline-flex; align-items: center; gap: 20px; padding: 11px 15px;
    border: 1px solid #b1c9b8; border-radius: 3px; font-size: 14px; font-weight: 700;
  }
  .feature-link:hover { color: #20332a; background: #e0e8df; }
  .feature-figure { margin: 0; display: grid; grid-template-rows: 1fr auto; background: #fff; color: #505751; }
  .feature-figure img { display: block; width: 100%; height: 100%; min-height: 260px; max-height: 440px; object-fit: contain; }
  .feature-figure figcaption { padding: 10px 16px; border-top: 1px solid #e3e7df; font-size: 12px; line-height: 1.5; }
  .other-work, .about { margin-top: clamp(46px, 8vw, 94px); }
  .other-work h2, .about h2 { font-size: clamp(30px, 4vw, 45px); margin: 8px 0 20px; letter-spacing: -.025em; }
  .project-row {
    display: flex; align-items: center; gap: clamp(14px, 3vw, 32px);
    border-top: 1px solid #d8dcd5; padding: 23px 0;
  }
  .project-row img { width: clamp(78px, 16vw, 160px); aspect-ratio: 4 / 3; object-fit: contain; background: #f0f2ed; }
  .project-row h3 { font-size: clamp(23px, 3vw, 34px); margin: 5px 0 9px; }
  .project-row h3 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .project-summary { max-width: 60ch; color: #505751; line-height: 1.6; margin: 0; }
  .project-link {
    display: grid; place-items: center; flex: 0 0 42px; height: 42px; margin-left: auto;
    border: 1px solid #c5cdc5; border-radius: 50%; font-size: 18px; color: #385547;
  }
  .project-link:hover { background: #e8eee7; }
  .about { border-top: 1px solid #d8dcd5; padding: 28px 0 48px; }
  .about p:last-child { max-width: 58ch; color: #505751; line-height: 1.7; }
  footer { border-top: 1px solid #d8dcd5; border-bottom: 0; font-size: 13px; color: #505751; }
  @media (max-width: 720px) {
    .featured.with-image { grid-template-columns: 1fr; }
    .feature-figure img { min-height: 0; max-height: 320px; }
  }
  @media (max-width: 460px) {
    .container { width: calc(100% - 2rem); }
    .project-row { flex-wrap: wrap; align-items: start; }
    .project-row img { width: 100%; max-height: 180px; }
    .project-row > div { flex: 1; min-width: 0; }
  }
</style>
