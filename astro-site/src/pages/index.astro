---
const files = import.meta.glob("../content/projects/*.md", { eager: true });

const projects = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, module]) => ({
    ...module.frontmatter,
    description: module.frontmatter.summary,
    slug: path.split("/").pop().replace(".md", ""),
  }));
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Engineering projects by Joe Hanko in mechanical engineering, mechatronics, and embedded systems." />
    <title>Joe Hanko — Engineering Projects</title>
  </head>

  <body>
    <div class="container">
      <header>
        <a href="/" class="brand">Joe Hanko<span>.</span></a>
        <nav>
          <a href="#work">Work</a>
          <a href="#about">About</a>
          <a href="https://github.com/joehanko" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <p class="eyebrow">MECHANICAL ENGINEERING / MECHATRONICS</p>
          <h1>Designing, building,<br />and making things work.</h1>
          <p class="intro">
            I'm Joe, a mechanical engineering student with a background
            in technology and software. I enjoy bringing together
            mechanical design, electronics, and embedded systems.
          </p>
        </section>

        <section id="work">
          <div class="section-header">
            <h2>Selected Work</h2>
            <span>2024 — 2026</span>
          </div>

          <div class="projects">
            {projects.map((project, index) => (
              <article class="project-card">
                <a href={`/projects/${project.slug}/`} class="project-image" aria-label={`View ${project.title}`}>
                  {project.cover ? (
                    <img src={project.cover} alt={`${project.title} project`} loading="lazy" />
                  ) : (
                    <span class="image-placeholder">PROJECT {String(index + 1).padStart(2, "0")}</span>
                  )}
                  <span class="image-arrow" aria-hidden="true">↗</span>
                </a>
                <div class="project-meta">
                  <span>{project.category}</span>
                  <span>{project.year}</span>
                </div>
                <h3><a href={`/projects/${project.slug}/`}>{project.title}</a></h3>
                <p>{project.description}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="about" class="about">
          <h2>About</h2>
          <p>
            My work spans mechanical design, rapid prototyping,
            embedded electronics, robotics, and software development.
            I'm particularly interested in mechatronics, automation,
            and engineering test systems.
          </p>
        </section>
      </main>

      <footer>
        <span>© {new Date().getFullYear()} Joe Hanko</span>
        <span>Engineering &amp; Technology</span>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    margin: 0;
    background: #fafaf8;
    color: #222;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(a) { color: inherit; text-decoration: none; }
  .container { max-width: 1320px; margin: auto; padding: 0 6%; }
  header {
    display: flex; align-items: center;
    justify-content: space-between;
    padding: 32px 0; border-bottom: 1px solid #ddd;
  }
  .brand { font-size: 18px; font-weight: 700; }
  .brand span { color: #999; }
  nav { display: flex; gap: 32px; }
  nav a { font-size: 13px; color: #555; }
  nav a:hover, .project-card h3 a:hover { color: #000; }
  .hero { padding: 135px 0 150px; }
  .eyebrow { font-size: 11px; letter-spacing: 2px; color: #777; margin-bottom: 32px; }
  h1, h2, h3 { font-family: Georgia, "Times New Roman", serif; font-weight: 400; }
  h1 { font-size: clamp(46px, 6vw, 88px); line-height: 1.14; letter-spacing: -2.5px; margin: 0 0 35px; }
  .intro { max-width: 580px; font-size: 17px; line-height: 1.9; color: #666; }
  .section-header {
    display: flex; align-items: baseline;
    justify-content: space-between;
    border-top: 1px solid #ddd;
    padding-top: 30px; margin-bottom: 45px;
  }
  .section-header h2 { font-size: 38px; margin: 0; }
  .section-header span, .project-meta { font-size: 12px; color: #777; }
  .projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 75px 32px; }
  .project-card { min-width: 0; }
  .project-image {
    position: relative;
    display: flex;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #e8e8e4;
    align-items: flex-end;
    padding: 22px;
    color: #888;
  }
  .project-image img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 350ms ease; }
  .project-image:hover img { transform: scale(1.025); }
  .image-placeholder { font-size: 11px; letter-spacing: 1.2px; }
  .image-arrow { position: absolute; right: 18px; top: 16px; color: #555; font-size: 18px; }
  .project-meta { display: flex; justify-content: space-between; gap: 16px; margin-top: 20px; }
  .project-card h3 { font-size: 27px; margin: 15px 0; }
  .project-card p { font-size: 14px; line-height: 1.8; color: #666; max-width: 490px; }
  .about { border-top: 1px solid #ddd; margin-top: 140px; padding: 65px 0 130px; }
  .about h2 { font-size: 42px; }
  .about p { max-width: 630px; line-height: 1.9; color: #666; }
  footer {
    border-top: 1px solid #ddd; padding: 30px 0 45px;
    display: flex; justify-content: space-between;
    gap: 16px; color: #777; font-size: 12px;
  }
  @media (prefers-reduced-motion: reduce) { .project-image img { transition: none; } }
  @media (max-width: 700px) {
    header { flex-wrap: wrap; gap: 20px; }
    nav { gap: 18px; }
    .hero { padding: 90px 0 110px; }
    h1 { letter-spacing: -1px; }
    .projects { grid-template-columns: 1fr; gap: 45px; }
    .section-header h2 { font-size: 32px; }
    .about { margin-top: 90px; }
  }
</style>
