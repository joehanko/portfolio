---
export function getStaticPaths() {
  const files = import.meta.glob("../../content/projects/*.md", { eager: true });

  return Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([path, project], index) => ({
      params: { slug: path.split("/").pop().replace(".md", "") },
      props: { project, projectNumber: String(index + 1).padStart(2, "0") },
    }));
}

const { project, projectNumber } = Astro.props;
const { frontmatter, Content } = project;
const { title, category, year, summary, cover, coverAlt, coverCaption } = frontmatter;
const highlights = Array.isArray(frontmatter.highlights) ? frontmatter.highlights.filter((item) => item?.value && item?.label).slice(0, 4) : [];
const gallery = Array.isArray(frontmatter.gallery) ? frontmatter.gallery.filter(Boolean) : [];
const headings = project.getHeadings().filter((heading) => heading.depth === 2);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={summary} />
    <title>{title} — Joe Hanko</title>
  </head>

  <body>
    <div class="container">
      <header>
        <a href="/" class="brand">Joe Hanko<span>.</span></a>
        <a href="/#work" class="back">← All projects</a>
      </header>

      <main>
        <section class="intro">
          <div class="metadata">
            <span>{projectNumber} / {category}</span>
            <span>{year}</span>
          </div>
          <h1>{title}</h1>
          <p class="summary">{summary}</p>
        </section>

        {cover && (
          <figure class="cover-frame">
            <img class="cover" src={cover} alt={coverAlt || title} fetchpriority="high" />
            {coverCaption && <figcaption>{coverCaption}</figcaption>}
          </figure>
        )}

        {highlights.length > 0 && (
          <ul class="highlights" aria-label="Project highlights">
            {highlights.map((item) => (
              <li class="highlight">
                <p class="highlight-value">{item.value}</p>
                <p class="highlight-label">{item.label}</p>
              </li>
            ))}
          </ul>
        )}

        <div class:list={["content-layout", { "with-contents": headings.length > 0 || gallery.length > 0 }]}>
          {(headings.length > 0 || gallery.length > 0) && (
            <aside>
              <nav aria-label="Case study contents" class="contents">
                <p class="eyebrow">In this case study</p>
                <ul>
                  {headings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
                  {gallery.length > 0 && <li><a href="#gallery-title">Project gallery</a></li>}
                </ul>
              </nav>
            </aside>
          )}
          <article class="prose">
            <Content />
          </article>
        </div>

        {gallery.length > 0 && (
          <section class="gallery" aria-labelledby="gallery-title">
            <p class="eyebrow">Images and screenshots</p>
            <h2 id="gallery-title">Project gallery</h2>
            <div class="gallery-grid">
              {gallery.map((image, index) => (
                <figure>
                  <a href={image} aria-label={`View ${title} image ${index + 1} at full size`}>
                    <img src={image} alt={`${title} project image ${index + 1}`} loading="lazy" />
                    <span aria-hidden="true">View full size ↗</span>
                  </a>
                </figure>
              ))}
            </div>
          </section>
        )}

        <a href="/#work" class="bottom-link">← Back to selected work</a>
      </main>

      <footer>
        <span>© {new Date().getFullYear()} Joe Hanko</span>
        <span>Engineering &amp; Technology</span>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    background: #fafaf8;
    color: #222522;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible) { outline: 2px solid currentColor; outline-offset: 5px; }
  .container { width: min(100% - 3rem, 1160px); margin-inline: auto; }
  header, footer {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 16px; padding: 25px 0; border-bottom: 1px solid #d8dcd5;
    font-size: 13px;
  }
  .brand { font-size: 18px; font-weight: 700; }
  .brand span { color: #456a59; }
  .back, .bottom-link { color: #385547; }
  .back:hover, .bottom-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  .intro { padding: clamp(48px, 8vw, 96px) 0 clamp(28px, 5vw, 55px); }
  .metadata {
    display: flex; justify-content: space-between; gap: 16px;
    color: #456354; font-size: 11px; font-weight: 700;
    line-height: 1.5; letter-spacing: .12em; text-transform: uppercase;
  }
  h1, h2 { font-family: Georgia, "Times New Roman", serif; font-weight: 400; }
  h1 {
    max-width: 950px; margin: 18px 0; font-size: clamp(42px, 7vw, 88px);
    line-height: 1.06; letter-spacing: -.045em;
  }
  .summary { max-width: 63ch; margin: 0; font-size: clamp(17px, 2vw, 20px); line-height: 1.65; color: #505751; }
  .cover-frame {
    margin: 0; border: 1px solid #d8dcd5; border-radius: 5px;
    overflow: hidden; background: #fff;
  }
  .cover { display: block; width: 100%; height: auto; max-height: 560px; object-fit: contain; }
  figcaption {
    padding: 12px 16px; border-top: 1px solid #d8dcd5;
    font-size: 13px; line-height: 1.55; color: #505751;
  }
  .highlights {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 1px; padding: 0; margin: 18px 0 0; list-style: none;
    border: 1px solid #d8dcd5; border-radius: 5px; background: #d8dcd5; overflow: hidden;
  }
  .highlight { min-width: 0; padding: 21px 18px; background: #f0f3ed; }
  .highlight-value {
    font-family: Georgia, serif; font-size: clamp(20px, 2.4vw, 29px);
    line-height: 1.2; margin: 0 0 7px; overflow-wrap: anywhere;
  }
  .highlight-label { margin: 0; font-size: 13px; line-height: 1.5; color: #505751; }
  .content-layout {
    display: grid; gap: clamp(25px, 6vw, 80px); margin-top: clamp(35px, 7vw, 78px);
    border-top: 1px solid #d8dcd5; padding: 36px 0 clamp(40px, 6vw, 72px);
  }
  .content-layout.with-contents { grid-template-columns: minmax(145px, 1fr) minmax(0, 3fr); }
  .contents { position: sticky; top: 25px; }
  .eyebrow {
    margin: 0 0 13px; color: #456354; font-size: 11px; line-height: 1.5;
    font-weight: 700; text-transform: uppercase; letter-spacing: .12em;
  }
  .contents ul { list-style: none; margin: 0; padding: 0; }
  .contents li { margin-bottom: 3px; }
  .contents a { display: inline-block; padding: 5px 0; color: #385547; font-size: 14px; line-height: 1.4; }
  .contents a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .prose { max-width: 72ch; font-size: 17px; line-height: 1.75; color: #404741; overflow-wrap: anywhere; }
  .prose :global(h2) {
    color: #222522; font-family: Georgia, "Times New Roman", serif; font-weight: 400;
    font-size: clamp(28px, 3.5vw, 39px); line-height: 1.15; letter-spacing: -.025em;
    margin: 43px 0 16px; padding-top: 25px; border-top: 1px solid #d8dcd5; scroll-margin-top: 24px;
  }
  .prose :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .prose :global(h3) { font-size: 18px; margin: 27px 0 10px; }
  .prose :global(p) { margin: 0 0 18px; }
  .prose :global(ul) { padding-left: 23px; }
  .prose :global(li) { padding-left: 4px; margin-bottom: 10px; }
  .prose :global(img) { display: block; max-width: 100%; height: auto; margin: 24px 0; }
  .prose :global(a) { color: #385547; text-decoration: underline; text-underline-offset: 3px; }
  .gallery { border-top: 1px solid #d8dcd5; padding: 30px 0 55px; }
  .gallery h2 { font-size: clamp(29px, 4vw, 42px); margin: 0 0 19px; scroll-margin-top: 24px; }
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 18px; }
  .gallery-grid figure { margin: 0; border: 1px solid #d8dcd5; border-radius: 4px; background: #f0f3ed; }
  .gallery-grid img { display: block; width: 100%; height: auto; max-height: 460px; object-fit: contain; }
  .gallery-grid span { display: block; padding: 10px 12px; font-size: 13px; color: #385547; }
  .gallery-grid a:hover span { text-decoration: underline; }
  .bottom-link { display: inline-block; margin-bottom: 42px; font-size: 14px; }
  footer { border-top: 1px solid #d8dcd5; border-bottom: 0; color: #505751; }
  @media (max-width: 700px) {
    .content-layout.with-contents { grid-template-columns: 1fr; }
    .contents { position: static; border-bottom: 1px solid #d8dcd5; padding-bottom: 18px; }
    .contents ul { display: flex; flex-wrap: wrap; column-gap: 16px; }
  }
  @media (max-width: 460px) {
    .container { width: calc(100% - 2rem); }
    .highlights { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .highlight { padding: 15px 12px; }
  }
</style>
