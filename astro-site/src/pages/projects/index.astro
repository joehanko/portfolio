---
import { siGithub } from "simple-icons";
import "../../styles/editorial.css";

const files = import.meta.glob("../../content/projects/*.md", { eager: true });
const projects = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, module]) => ({
    ...module.frontmatter,
    slug: path.split("/").pop().replace(".md", ""),
  }));
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Engineering projects by Joe Hanko, including Dirac Delta rocket avionics and the MACK-10 tensile tester."
    />
    <title>Joe Hanko — Engineering Projects</title>
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <a href="/" class="brand">Joe Hanko</a>
        <nav class="site-nav" aria-label="Main navigation">
          <a href="/projects/">Projects</a>
          <a href="#about">About</a>
          <a href="https://github.com/joehanko" class="github-link">
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={siGithub.path}></path>
            </svg>
            GitHub
          </a>
        </nav>
      </header>

      <main>
        <section class="archive-intro" aria-labelledby="archive-title">
          <div>
            <p class="eyebrow">
              {projects.length}
              {projects.length === 1 ? " project" : " projects"}
            </p>
            <h1 id="archive-title">Engineering projects</h1>
          </div>
          <p class="intro-copy">
            Rocket avionics, ground software, and mechanical test equipment.
          </p>
        </section>

        <section class="archive" aria-label="All engineering projects">
          {
            projects.length > 0 ? (
              <>
                <div
                  class="view-controls"
                  role="group"
                  aria-label="Project layout"
                  hidden
                >
                  <span class="eyebrow" aria-hidden="true">
                    View
                  </span>
                  <button
                    type="button"
                    data-project-view="two"
                    aria-label="Two-column view"
                    aria-pressed="true"
                    aria-controls="project-list"
                  >
                    <span class="view-icon view-icon-two" aria-hidden="true" />
                  </button>
                  <button
                    type="button"
                    data-project-view="one"
                    aria-label="Single-column view"
                    aria-pressed="false"
                    aria-controls="project-list"
                  >
                    <span class="view-icon" aria-hidden="true" />
                  </button>
                </div>
                <ul class="project-list" id="project-list" data-view="two">
                  {projects.map((project) => {
                    const cover =
                      project.cover ||
                      (Array.isArray(project.gallery) &&
                        project.gallery.find(Boolean));
                    return (
                      <li>
                        <a
                          class="project-card"
                          href={`/projects/${project.slug}/`}
                        >
                          {cover && (
                            <div class="project-media">
                              <img
                                src={cover}
                                alt={
                                  project.cover
                                    ? project.coverAlt || project.title
                                    : project.title
                                }
                                loading="lazy"
                              />
                            </div>
                          )}
                          <div class="project-copy">
                            <h2>
                              {project.title}
                              <span aria-hidden="true">↗</span>
                            </h2>
                            <p class="eyebrow project-meta">
                              {project.category} · {project.year}
                            </p>
                          </div>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </>
            ) : (
              <p>No projects published yet.</p>
            )
          }
        </section>
      </main>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Joe Hanko</span>
        <a href="https://github.com/joehanko" class="github-link">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d={siGithub.path}></path>
          </svg>
          GitHub
        </a>
      </footer>
    </div>
  </body>
</html>

<script>
  const controls = document.querySelector<HTMLElement>(".view-controls");
  const list = document.querySelector<HTMLElement>("#project-list");

  if (controls && list) {
    const buttons = controls.querySelectorAll<HTMLButtonElement>(
      "[data-project-view]",
    );
    controls.hidden = false;

    for (const button of buttons) {
      button.addEventListener("click", () => {
        list.dataset.view = button.dataset.projectView;
        for (const option of buttons) {
          option.setAttribute("aria-pressed", String(option === button));
        }
      });
    }
  }
</script>

<style>
  .archive-intro {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: end;
    gap: var(--grid-gap);
    padding-block: clamp(48px, 6vw, 82px) clamp(36px, 5vw, 70px);
  }

  .archive-intro .eyebrow {
    color: var(--ink);
  }

  h1 {
    max-width: 12ch;
    margin: 9px 0 0;
    font-size: clamp(36px, 4.6vw, 64px);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .intro-copy {
    max-width: 43ch;
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.55;
  }

  .archive {
    padding-block: 24px var(--section-space);
    border-top: 1px solid var(--rule);
  }

  .view-controls:not([hidden]) {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-bottom: 24px;
    padding-inline: 12px 7px;
    background: #e8e6e0;
  }

  .view-controls span.eyebrow {
    margin-right: 7px;
    color: var(--ink);
  }
  .view-controls button {
    display: grid;
    width: 30px;
    height: 34px;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: #747474;
    cursor: pointer;
  }
  .view-controls button:hover,
  .view-controls button[aria-pressed="true"] {
    color: var(--ink);
  }
  .view-controls button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -3px;
  }
  .view-icon {
    width: 12px;
    height: 12px;
    background: currentColor;
  }
  .view-icon-two {
    background: linear-gradient(
      to right,
      currentColor 42%,
      transparent 42% 58%,
      currentColor 58%
    );
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    column-gap: 10px;
    row-gap: clamp(28px, 4vw, 54px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-list[data-view="one"] {
    grid-template-columns: minmax(0, 1fr);
  }
  .project-card {
    display: block;
  }
  .project-media {
    background: var(--panel);
    overflow: hidden;
  }
  .project-media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .project-copy {
    padding-top: 15px;
  }
  .project-card:not(:has(.project-media)) .project-copy {
    border-top: 1px solid var(--rule);
  }

  .project-copy h2 {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 6px;
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.015em;
  }

  .project-card:hover h2 {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }
  .project-meta {
    color: #626262;
    letter-spacing: 0.04em;
  }

  @media (max-width: 809px) {
    .archive-intro,
    .project-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .archive-intro {
      gap: 15px;
    }
    .view-controls:not([hidden]) {
      display: none;
    }
  }
</style>
