---
import { siGithub } from "simple-icons";
import ProjectsDropdown from "./ProjectsDropdown.astro";
---

<header class="site-header">
  <a href="/" class="brand">Joe Hanko</a>
  <nav class="site-nav" aria-label="Main navigation">
    <ProjectsDropdown />
    <a href="https://www.linkedin.com/in/joehanko/" class="profile-link">
      <!-- LinkedIn mark from Bootstrap Icons (MIT). -->
      <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zM4.943 13.394V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248s-1.359.54-1.359 1.248c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.432.568-.879 1.232-.879.869 0 1.216.663 1.216 1.635v3.865h2.4V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193V6.169h-2.4c.03.678 0 7.225 0 7.225z" />
      </svg>
      LinkedIn
    </a>
    <a href="https://github.com/joehanko" class="profile-link">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
        <path d={siGithub.path} />
      </svg>
      GitHub
    </a>
  </nav>
</header>

<style>
  .site-nav {
    justify-content: flex-end;
    margin-inline-start: auto;
    gap: clamp(12px, 2vw, 24px);
  }

  .profile-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .profile-link svg { flex-shrink: 0; }
</style>
